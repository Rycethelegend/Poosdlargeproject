# Copy this file to .env and fill in the values. Never commit .env.

# MongoDB Atlas connection string
MONGODB_URI= "mongodb+srv://PoosdDB_User:BGqVpIHdmmpZjkWP@poosdbase.puafigd.mongodb.net/PoosdDatabase"#mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Secret used to sign login tokens. Any long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=

# Email for verification and password reset codes (any SMTP provider).
# Leave SMTP_HOST empty during local development and the codes are printed
# to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Poosdalatro <no-reply@poosdbasecontactmanager.casa>"

# Testing only: while SMTP_HOST is empty, show each code on the verify page
# instead of needing to read it from the server console. Ignored once SMTP_HOST
# is set. Never set this on the live server.
DEV_SHOW_CODES=false
